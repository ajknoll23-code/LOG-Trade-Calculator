    "name": "elite_anchor_plus_ranked_fragmentation",
    "not_a_gamma_rescue": true,
    "not_a_global_power_transform": true,
    "package_adjustment_display": {
      "display_adjustment": "max(0, relative_premium)",
      "identity": "When display_adjustment is positive, adjusted raw-total difference equals the effective-score difference.",
      "one_for_one_policy": "always zero package adjustment",
      "relative_premium": "P_stronger - P_weaker",
      "stronger_side": "side with greater effective_score_E"
    },
    "reason": "V3 showed that a single global power exponent carried only a tiny held-out advantage over raw addition. V4 tests a structurally different KTC-style mechanism: an explicit premium for the best asset plus explicit discounts for lesser package pieces.",
    "side_definition": {
      "effective_score_E": "T + P",
      "elite_factor_e": "clamp(v1 / 10000, 0, 1)",
      "missing_terms": "v2=0 and/or third-plus sum=0 when absent",
      "premium_P": "e * (stud_strength*v1 - second_piece_discount*v2 - third_plus_discount*sum(v_i for i>=3))",
      "raw_total_T": "sum(v_i)",
      "sort": "asset FV descending: v1 >= v2 >= v3 ..."
    }
  },
