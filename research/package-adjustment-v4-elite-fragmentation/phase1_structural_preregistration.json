  "hypothesis": {
    "fixed_value_scale_apex": 10000.0,
    "interpretation": {
      "second_piece_discount": "Discount applied to the second-best piece when paired with an elite anchor.",
      "stud_strength": "Absolute elite-anchor premium on the best asset; grows with v1/10000 rather than applying the same curvature to every asset.",
