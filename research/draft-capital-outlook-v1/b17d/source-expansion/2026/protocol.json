{
  "anchor_rule": {
    "calendar_year": "class_year_minus_1",
    "selection_rule": "Choose a source-coherent family with embedded Last update date closest to Sep 30; ties earlier date, then lexicographic URL.",
    "selection_uses_actual_nfl_draft_results": false,
    "selection_uses_capital_values": false,
    "selection_uses_fantasy_positions": false,
    "selection_uses_outcomes": false,
    "target_month_day": "09-30",
    "window_end_month_day": "10-15",
    "window_start_month_day": "09-15"
  },
  "candidate_class_years": [
    2008,
    2009,
    2010,
    2011,
    2012,
    2013,
    2026
  ],
  "existing_accepted_years": [
    2014,
    2015,
    2016,
    2017,
    2018,
    2019,
    2020,
    2021,
    2022,
    2023
  ],
  "existing_excluded_years": [
    2024,
    2025
  ],
  "existing_year_status_may_not_be_changed_here": true,
  "firewall": {
    "no_2027_score": true,
    "no_actual_draft_source_access": true,
    "no_capital_values": true,
    "no_fantasy_position_counts": true,
    "no_model_fit": true,
    "no_predictor_target_correlation": true,
    "no_production_change": true
  },
  "frozen_before_network_access": true,
  "legacy_transport": {
    "LEGACY_SINGLE_DOCUMENT": {
      "class_year_marker": true,
      "http_2xx": true,
      "last_update_inside_anchor_window": true,
      "last_update_required": true,
      "minimum_sequential_mock_entries": 60,
      "only_considered_if_no_strict_split3_family_is_found": true
    },
    "STRICT_SPLIT3": "Same requirements as strict_v3_transport.",
    "allowed_modes": [
      "STRICT_SPLIT3",
      "LEGACY_SINGLE_DOCUMENT"
    ],
    "applies_to": [
      2008,
      2009,
      2010,
      2011,
      2012,
      2013
    ],
    "legacy_single_document_does_not_auto_admit_class_to_c1": true,
    "legacy_single_document_is_transport_feasibility_only": true,
    "reason": "Older WalterFootball layout/hosting conventions predate the split-page implementation used by B17A V3."
  },
  "parser": {
    "entry_count_only": true,
    "entry_detection": "Count unique bold/strong labels matching Team: Player, POS, School in document order.",
    "hybrid_position_values_are_not_interpreted": true,
    "store_player_names": false,
    "store_position_labels": false,
    "store_team_names": false
  },
  "purpose": "Measure whether additional WalterFootball Walt preseason mock snapshots can be reconstructed without reading fantasy composition, actual NFL draft outcomes, capital values, or predictor-target association.",
  "schema_version": 1,
  "source_family": {
    "author_intent": "Walt only",
    "hosts": [
      "https://walterfootball.com",
      "https://debacled.walterfootball.com"
    ],
    "publisher": "WalterFootball"
  },
  "stage": "b17d_source_only_expansion_protocol",
  "strict_v3_transport": {
    "all_pages_class_year_marker": true,
    "all_pages_http_2xx": true,
    "all_pages_last_update_must_match": true,
    "all_pages_last_update_required": true,
    "applies_to": [
      2026
    ],
    "base_min_entries": 16,
    "base_patterns": [
      "draft{class_year}archiveMMDD.php",
      "draft{class_year}archive_MMDD.php"
    ],
    "combined_min_entries": 60,
    "companion_rule": "Insert _1 and _2 before .php.",
    "roles": [
      "base",
      "round1_remainder",
      "round2"
    ],
    "round1_remainder_min_entries": 15
  },
  "study_id": "draft-capital-outlook-v1"
}
