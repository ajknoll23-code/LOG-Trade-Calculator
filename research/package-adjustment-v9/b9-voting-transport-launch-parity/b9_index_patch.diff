+    <div style="color:var(--text-dim);font-size:11px;">${escapeHtml(p.pos)}${team}</div>
+  </div>`;
+}
+
+function packageV9MarkUnsafeSession(message){
+  const slot=packageV9AssignedSlot();
+  const session=slot ? packageV9SessionId(slot,false) : null;
+  if(slot && session) sessionStorage.setItem(packageV9AbortedKey(slot,session),'1');
+  packageV9SubmitError=message;
+}
+
+async function packageV9Submit(displaySide){
+  if(displaySide!=='L' && displaySide!=='R') return;
+  if(!packageV9Current || packageV9SubmitInFlight) return;
+  const {challenge,left,slot,session,displayOrder}=packageV9Current;
+  if(sessionStorage.getItem(packageV9AbortedKey(slot,session))==='1') return;
+  const id=String(challenge.id);
+  const choice=displaySide==='L' ? left : (left==='A' ? 'B' : 'A');
+  const timestamp=new Date().toISOString();
+  const vote=`__pkgv9val__|${id}|${choice}|${displaySide}|${session}|${timestamp}`;
+  const meta=`__pkgv9val_meta__|${id}|${left}|${slot}|${displayOrder}|${session}`;
+  const schema='__pkgv9val_schema__|1';
+  const voterRosterId=`__pkgv9val_session__|${slot}|${session}`;
+  const pendingKey=packageV9PendingKey(slot,session);
+  if(sessionStorage.getItem(pendingKey)){
+    packageV9MarkUnsafeSession('This session has an unresolved prior submission and cannot be safely continued. Please assign this same slot to a replacement voter using a fresh browser session.');
+    renderPackageVoteV9();
+    return;
+  }
+  packageV9SubmitInFlight=true;
+  packageV9SubmitError='';
+  sessionStorage.setItem(pendingKey,id);
+  renderPackageVoteV9();
+  try{
+    await fetch(KTC_SUBMIT_URL,{
+      method:'POST',
+      mode:'no-cors',
+      headers:{'Content-Type':'text/plain;charset=utf-8'},
+      body:JSON.stringify({voterRosterId,keep:vote,trade:meta,cut:schema})
+    });
+    packageV9Remember(slot,session,id);
+    sessionStorage.removeItem(pendingKey);
+    packageV9Current=null;
+  }catch(err){
+    packageV9MarkUnsafeSession('Vote submission status is uncertain. Do not retry this session. Please assign this same slot to a replacement voter using a fresh browser session.');
+  }finally{
+    packageV9SubmitInFlight=false;
+    renderPackageVoteV9();
+  }
+}
+
+function renderPackageVoteV9(){
+  const el=document.getElementById('packageVoteWrap');
+  if(!el) return;
+  const help=document.querySelector('.vote-help-card.package');
+  if(help) help.style.display='none';
