+  const c=packageV9Current.challenge;
+  const left=packageV9Current.left;
+  const leftSide=left==='A' ? c.side_A : c.side_B;
+  const rightSide=left==='A' ? c.side_B : c.side_A;
+  const leftHTML=leftSide.assets.map(packageV9AssetCard).join('');
+  const rightHTML=rightSide.assets.map(packageV9AssetCard).join('');
+  el.innerHTML=`
+    <div class="vote-help-card package" style="display:block;margin-bottom:10px;">
