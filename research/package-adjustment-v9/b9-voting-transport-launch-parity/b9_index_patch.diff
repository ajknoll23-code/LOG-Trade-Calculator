+/* PACKAGE_ADJUSTMENT_V9_B9_TRANSPORT_START
+   B8-frozen V9 human-validation transport. This block is activated ONLY
+   when ?pkgv9slot= is present. It loads voter-safe B8 artifacts pinned
+   to the durable B8 freeze commit and never loads the hidden evaluator. */
+const PACKAGE_V9_B8_COMMIT = '2ff1ca2a6ea440f2e1a4c390ae974a9666e9912a';
+const PACKAGE_V9_STUDY_ID = 'package-adjustment-v9-discordant-human-validation';
+const PACKAGE_V9_SAFE_URL = `https://raw.githubusercontent.com/ajknoll23-code/LOG-Trade-Calculator/${PACKAGE_V9_B8_COMMIT}/research/package-adjustment-v9/b8-human-catalog-assignment-freeze/b8_voter_safe_challenges.json`;
+const PACKAGE_V9_SCHEDULE_URL = `https://raw.githubusercontent.com/ajknoll23-code/LOG-Trade-Calculator/${PACKAGE_V9_B8_COMMIT}/research/package-adjustment-v9/b8-human-catalog-assignment-freeze/b8_voter_assignment_schedule.json`;
+const PACKAGE_V9_CONTRACT_URL = `https://raw.githubusercontent.com/ajknoll23-code/LOG-Trade-Calculator/${PACKAGE_V9_B8_COMMIT}/research/package-adjustment-v9/b8-human-catalog-assignment-freeze/b8_voting_transport_contract.json`;
+const PACKAGE_V9_SAFE_SHA256 = 'b00b61840bd4b497258624595760c5c6298a05a0b3f36865b9db87200b1c366d';
+const PACKAGE_V9_SCHEDULE_SHA256 = '9626fd524d721289fd5494c140d026a085b70dd44ec753c9a24f4838ea59737d';
+const PACKAGE_V9_CONTRACT_SHA256 = '6f8ae9e91efdbebe1cfe991134f3ea3afe05953e02b73ba64603ad72728d6b17';
+const PACKAGE_V9_TOTAL_SLOTS = 40;
+const PACKAGE_V9_BALLOTS_PER_SLOT = 24;
+let PACKAGE_V9_SAFE = null;
+let PACKAGE_V9_SCHEDULE = null;
+let PACKAGE_V9_CONTRACT = null;
+let PACKAGE_V9_STATUS = 'idle';
+let packageV9Current = null;
+let packageV9SubmitInFlight = false;
+let packageV9SubmitError = '';
+
+function packageV9QueryPresent(){
+  return new URLSearchParams(window.location.search).has('pkgv9slot');
+}
+
+function packageV9AssignedSlot(){
+  const raw=new URLSearchParams(window.location.search).get('pkgv9slot');
+  if(raw===null || !/^[0-9]+$/.test(raw)) return null;
+  const n=Number(raw);
+  return Number.isInteger(n) && n>=1 && n<=PACKAGE_V9_TOTAL_SLOTS ? n : null;
+}
+
+function packageV9SessionKey(slot){ return `pkgv9val_session_${slot}`; }
+function packageV9AttestKey(slot){ return `pkgv9val_attested_${slot}`; }
+function packageV9CompletedKey(slot,session){ return `pkgv9val_completed_${slot}_${session}`; }
+function packageV9PendingKey(slot,session){ return `pkgv9val_pending_${slot}_${session}`; }
+function packageV9AbortedKey(slot,session){ return `pkgv9val_aborted_${slot}_${session}`; }
+
+function packageV9RandomSessionId(){
+  if(!window.crypto || !window.crypto.getRandomValues) throw new Error('secure random unavailable');
+  const bytes=new Uint8Array(24); // 192 bits, exceeding frozen >=128-bit requirement.
+  window.crypto.getRandomValues(bytes);
+  return Array.from(bytes,b=>b.toString(16).padStart(2,'0')).join('');
+}
+
+function packageV9SessionId(slot,create){
+  const key=packageV9SessionKey(slot);
+  let id=sessionStorage.getItem(key);
+  if(!id && create){
+    id=packageV9RandomSessionId();
+    sessionStorage.setItem(key,id);
+  }
+  return id || null;
+}
+
+function packageV9Completed(slot,session){
+  try{
+    const rows=JSON.parse(sessionStorage.getItem(packageV9CompletedKey(slot,session)) || '[]');
+    return Array.isArray(rows) ? Array.from(new Set(rows.map(String))).slice(0,PACKAGE_V9_BALLOTS_PER_SLOT) : [];
+  }catch(e){ return []; }
+}
+
+function packageV9Remember(slot,session,id){
+  const rows=packageV9Completed(slot,session);
+  if(!rows.includes(String(id))) rows.push(String(id));
+  sessionStorage.setItem(packageV9CompletedKey(slot,session),JSON.stringify(rows.slice(0,PACKAGE_V9_BALLOTS_PER_SLOT)));
+}
+
+async function packageV9Sha256(text){
+  if(!window.crypto || !window.crypto.subtle) throw new Error('Web Crypto digest unavailable');
+  const buf=await window.crypto.subtle.digest('SHA-256',new TextEncoder().encode(text));
+  return Array.from(new Uint8Array(buf),b=>b.toString(16).padStart(2,'0')).join('');
+}
+
+function packageV9ForbiddenSafeKeys(obj){
+  const forbidden=new Set(['fv','raw_fv','v9_score','v9_favored_side','v1_7_favored_side','trade_signature','candidate_score']);
+  const hits=[];
+  function walk(x){
+    if(Array.isArray(x)){ x.forEach(walk); return; }
+    if(!x || typeof x!=='object') return;
+    for(const [k,v] of Object.entries(x)){
+      if(forbidden.has(String(k))) hits.push(String(k));
+      walk(v);
+    }
+  }
+  walk(obj);
+  return hits;
+}
+
+async function packageV9EnsureLoaded(){
+  if(PACKAGE_V9_STATUS==='loading' || PACKAGE_V9_STATUS==='ready') return;
+  PACKAGE_V9_STATUS='loading';
+  try{
+    const urls=[PACKAGE_V9_SAFE_URL,PACKAGE_V9_SCHEDULE_URL,PACKAGE_V9_CONTRACT_URL];
+    const responses=await Promise.all(urls.map(u=>fetch(u,{cache:'no-store'})));
+    responses.forEach(r=>{ if(!r.ok) throw new Error(`frozen B8 artifact HTTP ${r.status}`); });
+    const texts=await Promise.all(responses.map(r=>r.text()));
+    const hashes=await Promise.all(texts.map(packageV9Sha256));
+    if(hashes[0]!==PACKAGE_V9_SAFE_SHA256 || hashes[1]!==PACKAGE_V9_SCHEDULE_SHA256 || hashes[2]!==PACKAGE_V9_CONTRACT_SHA256){
+      throw new Error('frozen B8 artifact hash mismatch');
+    }
+    const safe=JSON.parse(texts[0]);
+    const sched=JSON.parse(texts[1]);
+    const contract=JSON.parse(texts[2]);
+    if(safe.schema_version!==1 || safe.study_id!==PACKAGE_V9_STUDY_ID || safe.status!=='FROZEN_B8_VOTER_SAFE_CATALOG' || safe.challenge_count!==960 || !Array.isArray(safe.challenges) || safe.challenges.length!==960) throw new Error('invalid B8 voter-safe catalog');
+    if(safe.fv_visible_to_voter!==false || safe.model_identity_visible_to_voter!==false || packageV9ForbiddenSafeKeys(safe).length) throw new Error('voter-safe leakage guard failed');
+    if(sched.schema_version!==1 || sched.study_id!==PACKAGE_V9_STUDY_ID || sched.status!=='FROZEN_B8_VOTER_ASSIGNMENT_SCHEDULE' || sched.seed!==2026100508 || sched.accepted_voter_slots!==40 || sched.challenges_per_slot!==24 || sched.total_unique_challenges!==960) throw new Error('invalid B8 schedule');
+    if(contract.schema_version!==1 || contract.study_id!==PACKAGE_V9_STUDY_ID || contract.status!=='FROZEN_B8_VOTING_TRANSPORT_CONTRACT_NOT_YET_DEPLOYED' || contract.slot_query_parameter!=='pkgv9slot' || contract.canonical_side_labels_visible_to_voter!==false || contract.normal_ktc_ratings_consume_v9_rows!==false || contract.vote_prefix!=='__pkgv9val__|' || contract.meta_prefix!=='__pkgv9val_meta__|' || contract.schema_marker!=='__pkgv9val_schema__|1') throw new Error('invalid B8 transport contract');
+    const ids=new Set(safe.challenges.map(c=>String(c.id)));
+    if(ids.size!==960) throw new Error('duplicate B8 challenge id');
+    for(let slot=1;slot<=40;slot++){
+      const spec=sched.slots && sched.slots[String(slot)];
+      if(!spec || Number(spec.accepted_voter_slot)!==slot || !Array.isArray(spec.challenge_order) || spec.challenge_order.length!==24 || new Set(spec.challenge_order.map(String)).size!==24 || !spec.challenge_order.every(cid=>ids.has(String(cid))) || !spec.display_left_by_challenge) throw new Error(`invalid B8 schedule slot ${slot}`);
+      for(const cid of spec.challenge_order){
+        const left=spec.display_left_by_challenge[String(cid)];
+        if(left!=='A' && left!=='B') throw new Error(`invalid B8 display side ${slot}/${cid}`);
+      }
+    }
+    PACKAGE_V9_SAFE=safe;
+    PACKAGE_V9_SCHEDULE=sched;
+    PACKAGE_V9_CONTRACT=contract;
+    PACKAGE_V9_STATUS='ready';
+    packageV9Current=null;
+  }catch(err){
+    console.warn('Package Adjustment V9 validation transport load failed:',err);
+    PACKAGE_V9_SAFE=null;
+    PACKAGE_V9_SCHEDULE=null;
+    PACKAGE_V9_CONTRACT=null;
+    PACKAGE_V9_STATUS='failed';
+  }
+  renderPackageVoteV9();
+}
+
+function packageV9BeginSession(){
+  const slot=packageV9AssignedSlot();
+  if(!slot) return;
+  try{
+    sessionStorage.setItem(packageV9AttestKey(slot),'1');
+    const session=packageV9SessionId(slot,true);
+    sessionStorage.removeItem(packageV9AbortedKey(slot,session));
+    renderPackageVoteV9();
+  }catch(e){
+    packageV9SubmitError='This browser cannot create a secure research session.';
+    renderPackageVoteV9();
+  }
+}
+
+function packageV9SelectChallenge(){
+  const slot=packageV9AssignedSlot();
+  const session=slot ? packageV9SessionId(slot,false) : null;
+  if(!slot || !session || !PACKAGE_V9_SAFE || !PACKAGE_V9_SCHEDULE) return null;
+  const spec=PACKAGE_V9_SCHEDULE.slots[String(slot)];
+  const completed=new Set(packageV9Completed(slot,session));
+  const id=spec.challenge_order.find(cid=>!completed.has(String(cid)));
+  if(!id) return null;
+  const challenge=PACKAGE_V9_SAFE.challenges.find(c=>String(c.id)===String(id));
+  const left=spec.display_left_by_challenge[String(id)];
+  const displayOrder=spec.challenge_order.indexOf(String(id));
+  if(!challenge || (left!=='A' && left!=='B') || displayOrder<0 || displayOrder>=24) return null;
+  return {challenge,left,slot,session,displayOrder};
+}
+
+function packageV9AssetCard(p){
+  const team=p.team ? ` &middot; ${ktcTeamLabel(p.team)}` : '';
+  return `<div class="need-cell" style="text-align:left;padding:10px;">
