+    el.innerHTML='<div class="vote-access-card"><b style="color:var(--red);">Invalid V9 research link.</b><br>Use a voter-specific URL containing ?pkgv9slot=1 through ?pkgv9slot=40.</div>';
+    return;
+  }
+  const session=packageV9SessionId(slot,false);
+  const attested=session && sessionStorage.getItem(packageV9AttestKey(slot))==='1';
+  if(!attested){
+    el.innerHTML=`<div class="vote-access-card" style="text-align:left;">
+      <b style="color:var(--gold);">Package Adjustment V9 Validation</b><br><br>
+      This link is assigned to one eligible voter only. Before receiving this voter link, you must not have seen V9 research artifacts, model verdicts, or this study design. Confirm that this was true, that you have not completed any other V9 research slot, and that you will judge every trade on your own dynasty valuation without consulting a trade calculator or value chart.<br><br>
+      <button class="tab-btn" style="width:100%;" onclick="packageV9BeginSession()">I Confirm — Begin 24 Trades</button>
+    </div>`;
+    return;
+  }
+  if(sessionStorage.getItem(packageV9AbortedKey(slot,session))==='1'){
+    el.innerHTML=`<div style="border:1px solid var(--red);border-radius:8px;padding:10px;color:var(--text-muted);font-size:13px;"><b style="color:var(--red);">Session closed for transport safety.</b><br>${escapeHtml(packageV9SubmitError || 'Do not retry this session. Assign the identical slot URL to a replacement voter using a fresh browser session.')}</div>`;
+    return;
+  }
+  const completed=packageV9Completed(slot,session);
+  if(completed.length>=24){
+    el.innerHTML=`<div style="color:var(--green);font-size:13px;padding:8px 0;">You've completed all 24 research trades for slot ${slot}. Thank you.</div>`;
+    return;
+  }
+  if(PACKAGE_V9_STATUS==='idle'){
+    packageV9EnsureLoaded();
+    el.innerHTML=`<div style="color:var(--text-dim);font-size:13px;padding:8px 0;">Loading frozen V9 research schedule for slot ${slot}...</div>`;
+    return;
+  }
+  if(PACKAGE_V9_STATUS==='loading'){
+    el.innerHTML=`<div style="color:var(--text-dim);font-size:13px;padding:8px 0;">Loading frozen V9 research schedule for slot ${slot}...</div>`;
+    return;
+  }
+  if(PACKAGE_V9_STATUS==='failed'){
+    el.innerHTML='<div style="color:var(--red);font-size:13px;padding:8px 0;">V9 research could not verify the frozen B8 catalog/schedule. No vote can be submitted.</div>';
